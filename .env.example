# Copy to .env for local development. Never commit .env.
#
# The service fails to start if a required variable is missing or invalid,
# and reports every problem at once rather than one per restart.

# --- Required -------------------------------------------------------------

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017

# HS256 signing key, minimum 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-random-data

# --- Optional (defaults shown) --------------------------------------------

HTTP_ADDR=:8080
GRPC_ADDR=:9090
MONGO_DATABASE=ecommerce
JWT_TTL=24h
SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=info
