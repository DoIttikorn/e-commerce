# Copy to .env for local development. Never commit .env.
#
# Every service reads the same variables; docker-compose.yml gives each one its
# own values. Only JWT_SECRET has to be set here for the compose stack to start.
#
# The service fails to start if a required variable is missing or invalid, and
# reports every problem at once rather than one per restart.

# --- Required -------------------------------------------------------------

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017

# HS256 signing key, minimum 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-random-data

# --- Optional (defaults shown) --------------------------------------------

HTTP_ADDR=:8080
GRPC_ADDR=:9090
MONGO_DATABASE=ecommerce

# Metrics and pprof. Bind to an internal interface in production — pprof can
# dump process memory and stall the process for the length of a profile.
ADMIN_ADDR=:6060

JWT_TTL=24h
SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=info

# --- Redis: caching and distributed locking -------------------------------
#
# Optional, and genuinely so: the Product service caches reads through it, and
# runs identically without it — only slower. Leaving REDIS_ADDR empty turns the
# cache off rather than failing startup.
#
# Use redis:6379 from inside Docker, localhost:6379 from the host.

# REDIS_ADDR=redis:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TTL=5m

# --- Kafka: asynchronous workflows ----------------------------------------
#
# Optional to the platform, but REQUIRED by the seller and product services:
# seller publishes the events product is built from, and both refuse to start
# without brokers rather than failing on the first write.
#
# Comma-separated. Use kafka:9092 from inside Docker, localhost:29092 from the host.
#
# KAFKA_GROUP_ID has no default: two deployments sharing an accidental group
# would silently consume each other's messages. Give every service its own.

# KAFKA_BROKERS=kafka:9092
# KAFKA_GROUP_ID=ecommerce
