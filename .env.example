# Copy to .env for local development. Never commit .env.
#
# The service fails to start if a required variable is missing or invalid, and
# reports every problem at once rather than one per restart.

# --- Required -------------------------------------------------------------

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017

# HS256 signing key, minimum 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-random-data

# --- Optional (defaults shown) --------------------------------------------

HTTP_ADDR=:8080
GRPC_ADDR=:9090
MONGO_DATABASE=ecommerce
JWT_TTL=24h
SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=info

# --- Redis: caching and distributed locking -------------------------------
#
# Optional. No domain uses Redis yet, so leaving REDIS_ADDR empty simply
# leaves the feature off. Uncomment when running `make docker-run-full`;
# use localhost:6379 when running the api outside Docker.

# REDIS_ADDR=redis:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# --- Kafka: asynchronous workflows ----------------------------------------
#
# Optional, on the same terms as Redis. Comma-separated broker list.
# Use kafka:9092 from inside Docker, localhost:29092 from the host.
#
# KAFKA_GROUP_ID has no default in the service: two deployments sharing an
# accidental group would silently consume each other's messages.

# KAFKA_BROKERS=kafka:9092
# KAFKA_GROUP_ID=ecommerce
