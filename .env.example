# Copy to .env for local development. Never commit .env.
#
# Every service reads the same variables; docker-compose.yml gives each one its
# own values. Only JWT_SECRET has to be set here for the compose stack to start.
#
# The service fails to start if a required variable is missing or invalid, and
# reports every problem at once rather than one per restart.

# --- Required -------------------------------------------------------------

# MongoDB connection string.
# Every service has its own MongoDB instance, each a single-node replica set
# (transactions and change streams both need an oplog). docker-compose.yml sets
# each service's URI; this value only matters when running a binary by hand.
#
#   in compose : mongodb://mongo-user:27017/?replicaSet=rs-user
#   from host  : mongodb://127.0.0.1:27017/?directConnection=true
#
# directConnection is required from the host because each set advertises its
# member as "mongo-<service>:27017", resolvable only inside the compose network.
#
#   user 27017   seller 27018   product 27019
MONGO_URI=mongodb://127.0.0.1:27017/?directConnection=true

# Token signing. One of the two schemes below is required.
#
# 1. Shared secret (HS256). Simple, and what the brief specifies. Every service
#    that can verify a token can also mint one, which is unremarkable with a
#    single service and a liability with six.
#
#      openssl rand -base64 48
#
JWT_SECRET=replace-me-with-at-least-32-characters-of-random-data

# 2. Key pair (EdDSA). Only the user service gets JWT_PRIVATE_KEY; everything
#    else gets JWT_PUBLIC_KEY and therefore cannot sign anything at all.
#
#      make keys
#
#    Set these and they take precedence over JWT_SECRET.
#
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# --- Optional (defaults shown) --------------------------------------------

HTTP_ADDR=:8080
GRPC_ADDR=:9090
MONGO_DATABASE=ecommerce

# Metrics and pprof. Bind to an internal interface in production — pprof can
# dump process memory and stall the process for the length of a profile.
ADMIN_ADDR=:6060

JWT_TTL=24h
SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=info

# --- Redis: caching and distributed locking -------------------------------
#
# Optional, and genuinely so: the Product service caches reads through it, and
# runs identically without it — only slower. Leaving REDIS_ADDR empty turns the
# cache off rather than failing startup.
#
# Use redis:6379 from inside Docker, localhost:6379 from the host.

# REDIS_ADDR=redis:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TTL=5m

# --- Kafka: asynchronous workflows ----------------------------------------
#
# Optional to the platform, but REQUIRED by the seller and product services:
# seller publishes the events product is built from, and both refuse to start
# without brokers rather than failing on the first write.
#
# Comma-separated. Use kafka:9092 from inside Docker, localhost:29092 from the host.
#
# KAFKA_GROUP_ID has no default: two deployments sharing an accidental group
# would silently consume each other's messages. Give every service its own.

# KAFKA_BROKERS=kafka:9092
# KAFKA_GROUP_ID=ecommerce
#
# Partitions a topic gets when a service creates it. This is the ceiling on
# consumer parallelism: a group can have at most one consumer per partition.
# KAFKA_PARTITIONS=3

# --- Tracing: OpenTelemetry -----------------------------------------------
#
# Optional. Unset, the service still propagates a trace context that arrives
# with a request — it just exports nothing of its own. That matters: a service
# that drops the context it was handed leaves a hole in someone else's trace.
#
# docker-compose.yml runs Jaeger, which accepts OTLP directly. Traces are at
# http://localhost:16686. Use jaeger:4317 from inside Docker, localhost:4317
# from the host.
#
# OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
#
# Fraction of root traces recorded, 0..1. The decision is taken once at the
# root and honoured by every service downstream, so a sampled trace is whole
# rather than full of gaps. 1.0 is right for a laptop and wrong for production.
# OTEL_TRACES_SAMPLER_ARG=1.0
